{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Four grouped funding purposes across single-state listed funding; column width indicates total share.",
  "width": 620,
  "height": 335,
  "background": "transparent",
  "padding": {"top": 100, "right": 5, "bottom": 5, "left": 5},
  "data": {
    "url": "data/state_stream_grouped_mosaic.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number",
        "funding_aud": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "{'QLD':'Queensland','NT':'Northern Territory','WA':'Western Australia','VIC':'Victoria','TAS':'Tasmania','NSW':'New South Wales','SA':'South Australia','ACT':'Australian Capital Territory'}[datum.state_code]",
      "as": "state_name"
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#52635a",
      "titleColor": "#17362f",
      "gridColor": "#e2e8e4",
      "gridWidth": 0.7,
      "domainColor": "#bacbc0",
      "tickColor": "#bacbc0"
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#17362f",
      "titleColor": "#17362f",
      "orient": "bottom",
      "direction": "vertical"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f5f7f3",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Share of eligible listed funding",
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "format": ".0%"
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "title": "Stream share within state",
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "format": ".0%"
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "stream_group",
          "type": "nominal",
          "title": "Grouped stream",
          "scale": {
            "domain": [
              "Priority places",
              "Priority species",
              "Threat response",
              "Monitoring"
            ],
            "range": [
              "#245d88",
              "#5d7ea7",
              "#b77a48",
              "#7662a2"
            ]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "title": "Purpose",
            "symbolSize": 80,
            "labelLimit": 135
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State or territory"
          },
          {
            "field": "stream_group",
            "title": "Grouped stream"
          },
          {
            "field": "funding_aud",
            "type": "quantitative",
            "title": "Listed funding (AUD)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'QLD' && datum.stream_group == 'Threat response'"
        },
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "xcenter"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "ycenter"
        },
        {
          "calculate": "'Queensland: AUD 26.59 million'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#101d1b"
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "field": "ycenter",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stream_group == 'Priority places' && (datum.state_code == 'QLD' || datum.state_code == 'NT' || datum.state_code == 'VIC' || datum.state_code == 'NSW')"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17362f"
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -8},
        "text": {"field": "state_name"}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stream_group == 'Priority places' && (datum.state_code == 'WA' || datum.state_code == 'TAS')"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17362f",
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -29},
        "text": {"field": "state_name"}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stream_group == 'Priority places' && datum.state_code == 'SA'"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "color": "#17362f"
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -52},
        "text": {"field": "state_name"}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'ACT' && datum.stream_group == 'Priority species'"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "color": "#17362f"
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -75},
        "text": {"field": "state_name"}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stream_group == 'Priority places' && (datum.state_code == 'WA' || datum.state_code == 'TAS')"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#52635a",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -25},
        "y2": {"value": -2}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'SA' && datum.stream_group == 'Priority places'"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#52635a",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -48},
        "y2": {"value": -2}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'ACT' && datum.stream_group == 'Priority species'"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xcenter"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#52635a",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "xcenter",
          "type": "quantitative",
          "scale": {"domain": [0, 1]}
        },
        "y": {"value": -71},
        "y2": {"value": -2}
      }
    }
  ]
}