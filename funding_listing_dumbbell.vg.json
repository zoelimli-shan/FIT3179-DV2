
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compare states’ shares of nationally listed threatened species with their shares of mapped priority-species funding. A connecting line measures difference, not change over time.",
  "width": 580,
  "height": 320,
  "background": "transparent",
  "data": {
    "url": "data/funding_listing_dumbbell.csv"
  },
  "encoding": {
    "y": {
      "field": "state_code",
      "type": "nominal",
      "sort": [
        "NSW",
        "TAS",
        "VIC",
        "SA",
        "NT",
        "WA",
        "ACT",
        "QLD"
      ],
      "axis": {
        "title": null,
        "grid": false,
        "labelFontSize": 12,
        "labelLimit": 220,
        "labelExpr": "{'NSW':'New South Wales','TAS':'Tasmania','VIC':'Victoria','SA':'South Australia','NT':'Northern Territory','WA':'Western Australia','ACT':'Australian Capital Territory','QLD':'Queensland'}[datum.label]"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#a2aaa5"
      },
      "encoding": {
        "x": {
          "field": "lower",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.3
            ]
          },
          "axis": {
            "title": "Share of total across states and territories",
            "format": ".0%",
            "grid": true,
            "gridColor": "#e3e9e5",
            "tickCount": 7
          }
        },
        "x2": {
          "field": "upper"
        },
        "tooltip": [
          {
            "field": "state_code",
            "title": "State or territory"
          },
          {
            "field": "listing_share",
            "type": "quantitative",
            "title": "Share of threatened-species listings",
            "format": ".1%"
          },
          {
            "field": "funding_share",
            "type": "quantitative",
            "title": "Share of priority-species funding",
            "format": ".1%"
          },
          {
            "field": "gap_pp",
            "type": "quantitative",
            "title": "Funding minus listings (percentage points)",
            "format": "+.1f"
          },
          {
            "field": "listed_species",
            "type": "quantitative",
            "title": "Threatened-species listings",
            "format": ",.0f"
          },
          {
            "field": "funding_aud",
            "type": "quantitative",
            "title": "Mapped priority-species funding (AUD)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "listing_share",
            "funding_share"
          ],
          "as": [
            "measure",
            "share"
          ]
        },
        {
          "calculate": "datum.measure == 'listing_share' ? 'Threatened-species listings' : 'Priority-species funding'",
          "as": "measure_label"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.3
            ]
          },
          "axis": {
            "title": "Share of total across states and territories",
            "format": ".0%",
            "grid": true,
            "gridColor": "#e3e9e5",
            "tickCount": 7
          }
        },
        "color": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Threatened-species listings",
              "Priority-species funding"
            ],
            "range": [
              "#66509a",
              "#245d88"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolSize": 140,
            "labelFontSize": 12
          }
        },
        "shape": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Threatened-species listings",
              "Priority-species funding"
            ],
            "range": [
              "circle",
              "diamond"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_code",
            "title": "State or territory"
          },
          {
            "field": "listing_share",
            "type": "quantitative",
            "title": "Share of threatened-species listings",
            "format": ".1%"
          },
          {
            "field": "funding_share",
            "type": "quantitative",
            "title": "Share of priority-species funding",
            "format": ".1%"
          },
          {
            "field": "gap_pp",
            "type": "quantitative",
            "title": "Funding share − listing share (pp)",
            "format": "+.1f"
          },
          {
            "field": "listed_species",
            "type": "quantitative",
            "title": "Threatened-species listings",
            "format": ",.0f"
          },
          {
            "field": "funding_aud",
            "type": "quantitative",
            "title": "Mapped priority-species funding (AUD)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'NSW' || datum.state_code == 'TAS'"
        },
        {
          "calculate": "datum.gap_pp < 0 ? 'Funding: ' + format(abs(datum.gap_pp), '.1f') + ' percentage points lower' : 'Funding: ' + format(datum.gap_pp, '.1f') + ' percentage points higher'",
          "as": "gap_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -11,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#263e52"
      },
      "encoding": {
        "x": {
          "field": "upper",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.3
            ]
          },
          "axis": {
            "title": "Share of total across states and territories",
            "format": ".0%",
            "grid": true,
            "gridColor": "#e3e9e5",
            "tickCount": 7
          }
        },
        "text": {
          "field": "gap_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#52635a",
      "titleColor": "#17362f",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e2e8e4",
      "gridWidth": 0.7,
      "domainColor": "#bacbc0",
      "tickColor": "#bacbc0"
    },
    "axisY": {
      "minExtent": 120
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#17362f",
      "titleColor": "#17362f",
      "orient": "bottom",
      "direction": "vertical"
    }
  }
}
