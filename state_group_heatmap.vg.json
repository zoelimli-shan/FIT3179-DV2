{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Indicative EPBC threatened-species occurrences by taxonomic group and jurisdiction.",
  "width": 560,
  "height": 285,
  "background": "transparent",
  "data": {
    "url": "data/threatened_group_by_state.csv"
  },
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 15,
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#52635a",
      "titleColor": "#17362f",
      "gridColor": "#e2e8e4",
      "gridWidth": 0.7,
      "domainColor": "#bacbc0",
      "tickColor": "#bacbc0"
    },
    "axisY": {
      "minExtent": 120
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#17362f",
      "titleColor": "#17362f",
      "orient": "bottom",
      "direction": "vertical"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f5f7f3",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "sort": [
            "WA",
            "NT",
            "SA",
            "QLD",
            "NSW",
            "VIC",
            "TAS",
            "ACT"
          ],
          "title": "State or territory",
          "axis": {
            "labelAngle": -90,
            "labelLimit": 250,
            "labelExpr": "datum.label == 'WA' ? 'Western Australia' : datum.label == 'NT' ? 'Northern Territory' : datum.label == 'SA' ? 'South Australia' : datum.label == 'QLD' ? 'Queensland' : datum.label == 'NSW' ? 'New South Wales' : datum.label == 'VIC' ? 'Victoria' : datum.label == 'TAS' ? 'Tasmania' : datum.label == 'ACT' ? 'Australian Capital Territory' : datum.label"
          }
        },
        "y": {
          "field": "taxon_group",
          "type": "nominal",
          "sort": [
            "Plants",
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians",
            "Fish",
            "Invertebrates"
          ],
          "title": "Species group"
        },
        "color": {
          "field": "listed_species",
          "type": "quantitative",
          "title": "Listed species",
          "scale": {
            "scheme": "purples",
            "domainMin": 0
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 135,
            "gradientThickness": 10,
            "title": "Entries"
          }
        },
        "tooltip": [
          {
            "field": "state_code",
            "title": "State or territory"
          },
          {
            "field": "taxon_group",
            "title": "Group"
          },
          {
            "field": "listed_species",
            "type": "quantitative",
            "title": "Listed species",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state_code == 'NSW' && datum.taxon_group == 'Plants'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "sort": [
            "WA",
            "NT",
            "SA",
            "QLD",
            "NSW",
            "VIC",
            "TAS",
            "ACT"
          ]
        },
        "y": {
          "field": "taxon_group",
          "type": "nominal"
        },
        "text": {
          "field": "listed_species",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}
