
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Nationally listed threatened-species counts by species group and Australian state or territory. Darker purple represents more listings, not necessarily higher extinction risk.",
  "width": 600,
  "height": 315,
  "background": "transparent",
  "data": {
    "url": "data/threatened_group_by_state.csv"
  },
  "transform": [
    {
      "calculate": "{'WA':'Western Australia','NT':'Northern Territory','SA':'South Australia','QLD':'Queensland','NSW':'New South Wales','VIC':'Victoria','TAS':'Tasmania','ACT':'Australian Capital Territory'}[datum.state_code]",
      "as": "state_name"
    }
  ],
  "mark": {
    "type": "rect",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "state_code",
      "type": "nominal",
      "sort": [
        "WA",
        "NT",
        "SA",
        "QLD",
        "NSW",
        "VIC",
        "TAS",
        "ACT"
      ],
      "title": "State or territory",
      "axis": {
        "labelAngle": 0,
        "labelAlign": "center",
        "labelFontSize": 11,
        "labelLineHeight": 14,
        "labelPadding": 10,
        "labelLimit": 95,
        "titlePadding": 18,
        "ticks": false,
        "domain": false,
        "labelExpr": "datum.label == 'WA' ? ['Western', 'Australia'] : datum.label == 'NT' ? ['Northern', 'Territory'] : datum.label == 'SA' ? ['South', 'Australia'] : datum.label == 'QLD' ? 'Queensland' : datum.label == 'NSW' ? ['New South', 'Wales'] : datum.label == 'VIC' ? 'Victoria' : datum.label == 'TAS' ? 'Tasmania' : datum.label == 'ACT' ? ['Australian', 'Capital', 'Territory'] : datum.label"
      }
    },
    "y": {
      "field": "taxon_group",
      "type": "nominal",
      "sort": [
        "Plants",
        "Birds",
        "Mammals",
        "Reptiles",
        "Amphibians",
        "Fish",
        "Invertebrates"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelPadding": 10,
        "labelLimit": 150,
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "listed_species",
      "type": "quantitative",
      "title": "Threatened-species listings",
      "scale": {
        "type": "sqrt",
        "scheme": "purples",
        "domainMin": 0
      },
      "legend": {
        "title": "Number listed",
        "orient": "right",
        "direction": "vertical",
        "gradientLength": 180,
        "gradientThickness": 13,
        "titleFontSize": 12,
        "labelFontSize": 12,
        "format": ",.0f"
      }
    },
    "stroke": {
      "condition": {
        "test": "datum.state_code == 'NSW' && datum.taxon_group == 'Plants'",
        "value": "#17362f"
      },
      "value": "#ffffff"
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "taxon_group",
        "type": "nominal",
        "title": "Species group"
      },
      {
        "field": "listed_species",
        "type": "quantitative",
        "title": "Number of listed species",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#52635a",
      "titleColor": "#17362f",
      "grid": false,
      "domainColor": "#bacbc0",
      "tickColor": "#bacbc0"
    },
    "axisY": {
      "minExtent": 115
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#17362f",
      "titleColor": "#17362f"
    }
  }
}
