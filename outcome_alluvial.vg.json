{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Year Five outcomes regrouped by later priority-list status.",
  "width": 240,
  "height": 210,
  "background": "transparent",
  "padding": 5,
  "data": {
    "url": "data/outcome_alluvial.csv",
    "format": {
      "type": "csv",
      "parse": {
        "entries": "number",
        "stage": "number",
        "low": "number",
        "high": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 1,
        "interpolate": "linear",
        "stroke": "#f7f7f1",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "stage",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "values": [0, 1],
            "labelExpr": "datum.value == 0 ? 'Year Five outcome' : '2022–2032 list'",
            "labelAngle": 0,
            "labelPadding": 12,
            "ticks": false,
            "grid": false,
            "domain": false
          }
        },
        "y": {
          "field": "low",
          "type": "quantitative",
          "stack": null,
          "scale": {
            "domain": [0, 71]
          },
          "axis": null
        },
        "y2": {
          "field": "high"
        },
        "detail": {
          "field": "flow",
          "type": "nominal"
        },
        "color": {
          "field": "outcome",
          "type": "nominal",
          "scale": {
            "domain": [
              "Improved",
              "No significant change",
              "Deteriorated"
            ],
            "range": [
              "#176b50",
              "#aeb9af",
              "#9a5c2f"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "outcome",
            "title": "Year Five outcome"
          },
          {
            "field": "list_status",
            "title": "2022–2032 list status"
          },
          {
            "field": "entries",
            "type": "quantitative",
            "title": "Entries",
            "format": "d"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "center": 12,
            "label": "24 improved"
          },
          {
            "center": 40,
            "label": "32 no significant|change"
          },
          {
            "center": 63.5,
            "label": "15 deteriorated"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "|",
        "lineHeight": 15,
        "color": "#17362f",
        "clip": false
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71]
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "center": 13.5,
            "label": "27 retained"
          },
          {
            "center": 49,
            "label": "44 absent from|newer list"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 20,
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "|",
        "lineHeight": 15,
        "color": "#17362f",
        "clip": false
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71]
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stage == 1"
        },
        {
          "calculate": "(datum.low + datum.high) / 2",
          "as": "center"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "stage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71]
          }
        },
        "text": {
          "field": "entries",
          "type": "quantitative",
          "format": "d"
        },
        "color": {
          "condition": {
            "test": "datum.outcome == 'No significant change'",
            "value": "#17362f"
          },
          "value": "#ffffff"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "low": 0.5,
            "high": 26.5
          },
          {
            "low": 27.5,
            "high": 70.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#52635a",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "x": {
          "value": 248
        },
        "y": {
          "field": "low",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71]
          }
        },
        "y2": {
          "field": "high"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "position": 0.5
          },
          {
            "position": 26.5
          },
          {
            "position": 27.5
          },
          {
            "position": 70.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#52635a",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "x": {
          "value": 243
        },
        "x2": {
          "value": 248
        },
        "y": {
          "field": "position",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71]
          }
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#52635a"
    },
    "view": {
      "stroke": null
    }
  }
}