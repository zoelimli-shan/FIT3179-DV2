
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Year Five conservation outcomes and their later 2022–2032 priority-list status. Band thickness represents the number of entries.",
  "width": 320,
  "height": 250,
  "background": "transparent",
  "padding": {
    "left": 165,
    "right": 165,
    "top": 18,
    "bottom": 25
  },

  "data": {
    "url": "data/outcome_alluvial.csv",
    "format": {
      "type": "csv",
      "parse": {
        "entries": "number",
        "stage": "number",
        "low": "number",
        "high": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.95,
        "interpolate": "linear",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },

      "encoding": {
        "x": {
          "field": "stage",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [0, 1],
            "nice": false
          },
          "axis": {
            "values": [0, 1],
            "labelExpr": "datum.value == 0 ? 'Year Five outcome' : '2022–2032 list'",
            "labelAngle": 0,
            "labelPadding": 16,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "ticks": false,
            "grid": false,
            "domain": false
          }
        },

        "y": {
          "field": "low",
          "type": "quantitative",
          "stack": null,
          "scale": {
            "domain": [0, 71],
            "nice": false
          },
          "axis": null
        },

        "y2": {
          "field": "high"
        },

        "detail": {
          "field": "flow",
          "type": "nominal"
        },

        "color": {
          "field": "outcome",
          "type": "nominal",
          "scale": {
            "domain": [
              "Improved",
              "No significant change",
              "Deteriorated"
            ],
            "range": [
              "#176b50",
              "#aeb9af",
              "#9a5c2f"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "outcome",
            "type": "nominal",
            "title": "Outcome by 2020"
          },
          {
            "field": "list_status",
            "type": "nominal",
            "title": "Later priority-list status"
          },
          {
            "field": "entries",
            "type": "quantitative",
            "title": "Number of priorities",
            "format": "d"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "center": 12,
            "label": "24 improved"
          },
          {
            "center": 40,
            "label": "32 no significant|change"
          },
          {
            "center": 63.5,
            "label": "15 deteriorated"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -15,
        "fontSize": 13,
        "fontWeight": 600,
        "lineBreak": "|",
        "lineHeight": 17,
        "color": "#17362f",
        "clip": false
      },

      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          }
        },

        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71],
            "nice": false
          }
        },

        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "center": 13.5,
            "label": "27 retained"
          },
          {
            "center": 49,
            "label": "44 not on|newer list"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 15,
        "fontSize": 13,
        "fontWeight": 600,
        "lineBreak": "|",
        "lineHeight": 17,
        "color": "#17362f",
        "clip": false
      },

      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          }
        },

        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71],
            "nice": false
          }
        },

        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.stage == 1"
        },
        {
          "calculate": "(datum.low + datum.high) / 2",
          "as": "center"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 11,
        "fontWeight": "bold",
        "clip": true
      },

      "encoding": {
        "x": {
          "field": "stage",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "nice": false
          }
        },

        "y": {
          "field": "center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 71],
            "nice": false
          }
        },

        "text": {
          "field": "entries",
          "type": "quantitative",
          "format": "d"
        },

        "color": {
          "condition": {
            "test": "datum.outcome == 'No significant change'",
            "value": "#17362f"
          },
          "value": "#ffffff"
        },

        "tooltip": [
          {
            "field": "outcome",
            "title": "Outcome by 2020"
          },
          {
            "field": "list_status",
            "title": "Later priority-list status"
          },
          {
            "field": "entries",
            "type": "quantitative",
            "title": "Number of priorities",
            "format": "d"
          }
        ]
      }
    }
  ],

  "config": {
    "font": "Source Sans 3",

    "axis": {
      "labelFont": "Source Sans 3",
      "labelFontSize": 12,
      "labelColor": "#52635a",
      "titleColor": "#17362f"
    },

    "view": {
      "stroke": null
    }
  }
}
